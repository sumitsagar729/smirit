{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Smriti",
  "version": "0.1.0",
  "identifier": "app.smriti.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Smriti",
        "width": 1360,
        "height": 860,
        "minWidth": 960,
        "minHeight": 620,
        "center": true,
        "theme": "Dark",
        "backgroundColor": "#121214",
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' smriti: http://smriti.localhost data: blob:; media-src 'self' smriti: http://smriti.localhost blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "Smriti",
    "category": "Photography",
    "shortDescription": "Private, offline family photo library",
    "longDescription": "Smriti finds every family photo and video by who is in it, when, and where. Everything runs on your computer; nothing is uploaded.",
    "copyright": "Copyright © 2026 Sumit Sagar",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  }
}
